# OtoWeb public configuration
#
# Copy this file to .env.local and adjust values for your environment.
# Never commit real credentials, API keys, or tokens.
# Only public, browser-safe values belong in NEXT_PUBLIC_* variables.

# Public canonical site URL used for metadata and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public showroom identifier used for bare-loopback local development
# (`localhost` or `127.0.0.1`) when no tenant hostname is supplied.
# Lowercase letters, digits, and hyphens only.
NEXT_PUBLIC_SHOWROOM_SLUG=prima-auto-gallery

# Server-only platform root for wildcard tenant subdomains.
# Production example: otoweb.id, serving prima.otoweb.id, tenant-b.otoweb.id,
# and <tenant-slug>.otoweb.id from one deployment. Development and tests also
# accept *.localhost automatically. Uncomment to override the default.
# TENANT_ROOT_DOMAIN=otoweb.id

# Authentication is provided by this PostgreSQL database. There is no external
# identity provider. Create or reset an admin account after migrations:
#   pnpm auth:admin --email admin@example.com --name "Administrator"
# Omit --password to generate one; the command prints it once.
#
# Server-only PostgreSQL connection string used by Drizzle migrations, seeds,
# and the local auth/session store. The default below matches a local Postgres
# instance; replace it for your project.
# Never commit a real database password.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Vehicle image storage (optional in development).
#
# Cloudflare R2 is the recommended production provider. Create a bucket, an R2
# API token with Object Read & Write, and a public bucket domain (r2.dev or a
# custom domain). Set MEDIA_PROVIDER=r2 and all R2_* values together.
# MEDIA_PROVIDER=r2
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=otoweb-media
# R2_PUBLIC_BASE_URL=https://media.example.com
# Optional: override the endpoint for S3-compatible gateways/tests.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_REGION=auto
# MEDIA_UPLOAD_FOLDER=otoweb/vehicles
#
# Cloudinary remains supported as an alternative.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_UPLOAD_FOLDER=otoweb/vehicles
#
# Local development and CI use a deterministic fake provider. Uploaded files
# are written under MEDIA_LOCAL_DIR and served from MEDIA_PUBLIC_PREFIX.
# MEDIA_PROVIDER=fake
# MEDIA_LOCAL_DIR=public/uploads
# MEDIA_PUBLIC_PREFIX=/uploads

# Custom domains (server-only provider configuration).
# Development and tests default to a deterministic fake provider; production
# without a provider fails closed instead of pretending to verify a domain.
# DOMAIN_PROVIDER=fake
#
# Production: point the platform at a DNS/SSL provisioning service that
# implements the contract in specs/013-custom-domains/contracts/domain-provider.md.
# DOMAIN_PROVIDER=http
# DOMAIN_PROVIDER_URL=https://provisioner.example.internal
# DOMAIN_PROVIDER_TOKEN=replace-with-server-only-token
#
# CNAME target shown in custom-domain DNS instructions. Defaults to
# TENANT_ROOT_DOMAIN (otoweb.id).
# CUSTOM_DOMAIN_CNAME_TARGET=otoweb.id
