# OtoWeb public configuration
#
# Copy this file to .env.local and adjust values for your environment.
# Never commit real credentials, API keys, service-role secrets, or tokens.
# Only public, browser-safe values belong in NEXT_PUBLIC_* variables.

# Public canonical site URL used for metadata and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public showroom identifier used for local development when the request
# hostname does not match a seeded tenant domain. Lowercase letters, digits,
# and hyphens only.
NEXT_PUBLIC_SHOWROOM_SLUG=prima-auto-gallery

# Supabase project configuration (browser-safe values only).
# Replace these placeholders with the values from your Supabase project.
# Auth uses these public values for cookie-based sessions. The service-role key
# must never be added to this file, to NEXT_PUBLIC_* variables, or to the
# repository; platform operators invite showroom accounts from Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Allow <NEXT_PUBLIC_SITE_URL>/auth/callback in Supabase Auth URL Configuration.

# Server-only PostgreSQL connection string used by Drizzle migrations and seeds.
# The default below matches a local Supabase CLI database; replace it for your
# project. Never commit a real database password or the service-role key.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Vehicle image storage (optional in development).
# Production requires all three Cloudinary values together. This repository
# intentionally ships no real credentials.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_UPLOAD_FOLDER=otoweb/vehicles
#
# Local development and CI use a deterministic fake provider. Uploaded files
# are written under MEDIA_LOCAL_DIR and served from MEDIA_PUBLIC_PREFIX.
# MEDIA_PROVIDER=fake
# MEDIA_LOCAL_DIR=public/uploads
# MEDIA_PUBLIC_PREFIX=/uploads
